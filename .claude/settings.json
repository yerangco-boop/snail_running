{
  "permissions": {
    "deny": [
      "Read(./android/key.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-check.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
